{
  "name": "floorplan3d-card",
  "version": "0.0.0-dev",
  "description": "Home Assistant Lovelace card: 3D floorplan with auto-placed devices",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun scripts/build.mjs",
    "watch": "bun scripts/build.mjs --watch",
    "test": "bun test --parallel",
    "lint": "bun lint",
    "fmt": "bun fmt",
    "typecheck": "bun check",
    "demo": "bun scripts/build.mjs && python3 -m http.server 8765",
    "screenshot": "bun scripts/screenshot.mjs",
    "check:model": "bun scripts/model-check.mjs",
    "check:perf": "bun scripts/perf-check.mjs",
    "check:all": "bun scripts/build.mjs && bun scripts/screenshot.mjs && bun scripts/model-check.mjs",
    "check-model": "bun tools/check-model.mjs",
    "deploy": "bun scripts/deploy.mjs",
    "make-demo-model": "bun scripts/make-demo-model.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "three": "0.187.0",
    "three-gpu-pathtracer": "0.0.28",
    "three-mesh-bvh": "0.9.18"
  },
  "devDependencies": {
    "@mdi/js": "7.4.47",
    "@types/three": "0.187.0",
    "happy-dom": "21.0.4",
    "puppeteer-core": "25.12.0"
  }
}
